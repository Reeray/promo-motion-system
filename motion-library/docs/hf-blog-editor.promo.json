{
  "v": 1,
  "id": "hf-blog-editor",
  "theme": "light",
  "font": "hf",
  "grid": {
    "bpm": 120
  },
  "scenes": [
    {
      "id": "title",
      "kind": "ui",
      "surface": "hf-blog-jz-title",
      "enter": "scale-pop-in",
      "exit": "scale-up-cut"
    },
    {
      "id": "overview",
      "kind": "ui",
      "surface": "hf-blog-burst",
      "enter": "scale-pop-in",
      "exit": "push-off-left"
    },
    {
      "id": "write",
      "kind": "ui",
      "surface": "hf-blog-write",
      "enter": "glide-in",
      "exit": "scale-up-cut"
    },
    {
      "id": "team-title",
      "kind": "text",
      "effect": "mask-reveal-up",
      "copy": "Add Coauthors to write together",
      "size": "md",
      "hold": "normal",
      "enter": "scale-pop-in",
      "exit": "push-off-left"
    },
    {
      "id": "team",
      "kind": "ui",
      "surface": "hf-blog-team",
      "enter": "glide-in",
      "exit": "scale-up-cut"
    },
    {
      "id": "publish",
      "kind": "ui",
      "surface": "hf-blog-publish-zoom",
      "enter": "scale-pop-in",
      "exit": "scale-up-cut"
    },
    {
      "id": "modal",
      "kind": "ui",
      "surface": "hf-blog-publish-modal",
      "enter": "scale-pop-in",
      "exit": "push-off-left"
    },
    {
      "id": "cta",
      "kind": "text",
      "effect": "spring-scale-in",
      "copy": "Come post your AI articles on Hugging Face blog",
      "sub": "Exclusive to Team & Enterprise",
      "size": "md",
      "hold": "long",
      "enter": "glide-in",
      "exit": "scale-up-cut"
    },
    {
      "id": "ending",
      "kind": "ui",
      "surface": "hf-logo-animation",
      "enter": "scale-pop-in",
      "exit": "scale-up-cut"
    }
  ],
  "sound": {
    "sfx": "on"
  }
}
